<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color for the input field. Changed to a slightly lighter blue for better contrast. -->
    <solid android:color="@color/dark_card_bg" />

    <!-- Rounded corners to match the card style -->
    <corners android:radius="8dp" />

    <!-- A subtle border to define the field -->
    <stroke
        android:width="1dp"
        android:color="@color/dark_bg" />

</shape>

